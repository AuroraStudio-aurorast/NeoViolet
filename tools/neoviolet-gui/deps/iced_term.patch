     mod handle_input_method_event_tests {
         use super::*;
 
+        fn character_key() -> iced::keyboard::Event {
+            iced::keyboard::Event::KeyPressed {
+                key: Key::Character("a".into()),
+                modified_key: Key::Character("a".into()),
+                physical_key: iced_core::keyboard::key::Physical::Code(
+                    iced_core::keyboard::key::Code::KeyA,
+                ),
+                location: iced_core::keyboard::Location::Standard,
+                modifiers: Modifiers::empty(),
+                text: Some("a".into()),
+                repeat: false,
+            }
+        }
+
+        #[test]
+        fn enabled_input_method_does_not_swallow_normal_keyboard_text() {
+            let terminal =
+                Terminal::new(0, crate::settings::Settings::default()).unwrap();
+            let view = TerminalView { term: &terminal };
+            let mut state = TerminalViewState::new(0);
+            view.handle_input_method_event(
+                &mut state,
+                &input_method::Event::Opened,
+            );
+            let command = view.handle_keyboard_event(
+                &mut state,
+                &mut iced_core::clipboard::Null,
+                &character_key(),
+            );
+            assert!(
+                matches!(command, Some(Command::Write(bytes)) if bytes == b"a")
+            );
+        }
+
+        #[test]
+        fn composing_text_never_reaches_pty_as_raw_keys() {
+            let terminal =
+                Terminal::new(0, crate::settings::Settings::default()).unwrap();
+            let view = TerminalView { term: &terminal };
+            let mut state = TerminalViewState::new(0);
+            view.handle_input_method_event(
+                &mut state,
+                &input_method::Event::Preedit("a".into(), Some(1..1)),
+            );
+            assert!(view
+                .handle_keyboard_event(
+                    &mut state,
+                    &mut iced_core::clipboard::Null,
+                    &character_key(),
+                )
+                .is_none());
+            view.handle_input_method_event(
+                &mut state,
+                &input_method::Event::Preedit(String::new(), None),
+            );
+            let command = view.handle_keyboard_event(
+                &mut state,
+                &mut iced_core::clipboard::Null,
+                &character_key(),
+            );
+            assert!(
+                matches!(command, Some(Command::Write(bytes)) if bytes == b"a")
+            );
+        }
+
+        #[test]
+        fn clicking_away_discards_preedit() {
+            let terminal =
+                Terminal::new(0, crate::settings::Settings::default()).unwrap();
+            let view = TerminalView { term: &terminal };
+            let mut state = TerminalViewState::new(0);
+            state.focus();
+            view.handle_input_method_event(
+                &mut state,
+                &input_method::Event::Preedit("ni".into(), Some(2..2)),
+            );
+            view.handle_focus(
+                &iced::Event::Mouse(mouse::Event::ButtonPressed(
+                    mouse::Button::Left,
+                )),
+                &mut state,
+                false,
+            );
+            assert!(!state.is_focused());
+            assert!(
+                state.ime_preedit.is_none(),
+                "cancel stale composition on blur"
+            );
+        }
