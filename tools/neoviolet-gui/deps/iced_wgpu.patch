+
+fn instance_descriptor(backends: wgpu::Backends) -> wgpu::InstanceDescriptor {
+    wgpu::InstanceDescriptor {
+        backends,
+        flags: if cfg!(feature = "strict-assertions") {
+            wgpu::InstanceFlags::debugging()
+        } else {
+            wgpu::InstanceFlags::empty()
+        },
+        // HWND swapchains ignore alpha. DirectComposition keeps transparent
+        // secondary windows working even when the first window is opaque.
+        backend_options: wgpu::BackendOptions {
+            dx12: wgpu::Dx12BackendOptions {
+                presentation_system:
+                    wgpu_types::Dx12SwapchainKind::DxgiFromVisual,
+                ..Default::default()
+            },
+            ..Default::default()
+        },
+        ..Default::default()
+    }
+}
+
+fn preferred_alpha_mode(
+    alpha_modes: &[wgpu::CompositeAlphaMode],
+    backend: wgpu::Backend,
+) -> wgpu::CompositeAlphaMode {
+    // DXGI composition swapchains require premultiplied alpha for transparency.
+    if backend == wgpu::Backend::Dx12
+        && alpha_modes.contains(&wgpu::CompositeAlphaMode::PreMultiplied)
+    {
+        return wgpu::CompositeAlphaMode::PreMultiplied;
+    }
+    if alpha_modes.contains(&wgpu::CompositeAlphaMode::PostMultiplied) {
+        wgpu::CompositeAlphaMode::PostMultiplied
+    } else if alpha_modes.contains(&wgpu::CompositeAlphaMode::PreMultiplied) {
+        wgpu::CompositeAlphaMode::PreMultiplied
+    } else {
+        wgpu::CompositeAlphaMode::Auto
+    }
+}
+
+#[cfg(test)]
+mod transparency_tests {
+    use super::{instance_descriptor, preferred_alpha_mode};
+    use wgpu::{Backend, Backends, CompositeAlphaMode};
+    use wgpu_types::Dx12SwapchainKind;
+
+    #[test]
+    fn dx12_uses_a_composition_swapchain_that_can_present_transparency() {
+        let descriptor = instance_descriptor(Backends::DX12);
+        assert_eq!(descriptor.backends, Backends::DX12);
+        assert_eq!(
+            descriptor.backend_options.dx12.presentation_system,
+            Dx12SwapchainKind::DxgiFromVisual,
+        );
+    }
+
+    #[test]
+    fn direct_composition_prefers_premultiplied_alpha() {
+        let modes = [
+            CompositeAlphaMode::PostMultiplied,
+            CompositeAlphaMode::PreMultiplied,
+        ];
+        assert_eq!(
+            preferred_alpha_mode(&modes, Backend::Dx12),
+            CompositeAlphaMode::PreMultiplied,
+        );
+        assert_eq!(
+            preferred_alpha_mode(&modes, Backend::Vulkan),
+            CompositeAlphaMode::PostMultiplied,
+        );
+        assert_eq!(
+            preferred_alpha_mode(&[CompositeAlphaMode::Opaque], Backend::Dx12),
+            CompositeAlphaMode::Auto,
+        );
+    }
+}
